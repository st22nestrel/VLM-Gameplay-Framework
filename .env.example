# Copy to .env and replace only the values needed by your backend.
# These are dummy values, never working credentials. Delete unused placeholder
# entries. Local Transformers needs no API key for public models. Existing
# process environment values take priority.

# Default credential name for the OpenAI-compatible backend. Not needed by the
# bundled Google/vLLM configs, which select their own names below.
OPENAI_API_KEY=replace-with-your-provider-api-key

# Google AI Studio / Gemini API (gameplay_gemma4_google.yaml).
GEMINI_API_KEY=replace-with-your-google-ai-studio-key

# vLLM example: EMPTY works only when your local server has no authentication.
# If authentication is enabled, replace EMPTY with the server's configured key.
VLLM_API_KEY=EMPTY

# Hugging Face gated/private model downloads. HF_TOKEN is preferred;
# HUGGING_FACE_HUB_TOKEN is the legacy fallback supported by llama.cpp downloads.
HF_TOKEN=replace-with-your-hugging-face-token
HUGGING_FACE_HUB_TOKEN=replace-with-your-hugging-face-token

# Optional Modal proxy authentication. To use this pair, set api_key_id_env:
# MODAL_PROXY_TOKEN_ID and api_key_secret_env: MODAL_PROXY_TOKEN_SECRET in
# gameplay.openai. Both are required; the pair takes priority over api_key_env.
MODAL_PROXY_TOKEN_ID=replace-with-your-modal-token-id
MODAL_PROXY_TOKEN_SECRET=replace-with-your-modal-token-secret

# Optional SDK/Hugging Face settings. Uncomment only if required.
# OPENAI_ORG_ID=replace-with-your-organization-id
# OPENAI_PROJECT_ID=replace-with-your-project-id
# HF_HOME=C:/path/to/shared/huggingface-cache
# HF_HUB_CACHE=C:/path/to/shared/huggingface-cache/hub
# HF_HUB_OFFLINE=1
# HF_HUB_DISABLE_TELEMETRY=1

# API endpoints, model IDs, and llama-server paths are YAML settings, not env
# variables. api_key_env and hf_token_env may name custom variables; if you
# customize those settings, add matching entries to your private .env.
